{
  // 5chan Board manager settings — controls pagination, thread lifecycle, and auto-moderation
  "boardManagerSettings": {
    // Number of threads shown per page
    "perPage": 15,
    // Number of pages on the board. Total thread capacity = perPage x pages
    "pages": 10,
    // Replies past a thread's first bumpLimit no longer bump it: it stays open, sinks, and is
    // archived once it falls off the last page (4chan behaviour). Applied by
    // @pkcprotocol/active-page-sort (see "pages" below); the board manager writes this value
    // into the sort's bumpLimit option, so a board that does not run the sort has no bump limit.
    "bumpLimit": 300,
    // How long archived threads are kept before permanent deletion and purge, in seconds (172800 = 48h)
    "archivePurgeSeconds": 172800,
    // Reason strings attached to automated moderation actions (visible in logs and web UI to users)
    "moderationReasons": {
      // Reason shown when a thread is archived because it fell past the last page
      "archiveCapacity": "5chan board manager: thread archived — exceeded board capacity",
      // Reason shown when an archived thread is permanently purged after retention expires
      "purgeArchived": "5chan board manager: thread purged — archive retention expired",
      // Reason shown when author-deleted content is purged
      "purgeDeleted": "5chan board manager: content purged — author-deleted",
      // Reason shown when a thread is purged because it fell past the last page of a board without an archive
      "purgeCapacity": "5chan board manager: thread purged — exceeded board capacity",
    },
  },

  // Board options — applied directly to the board itself (Bitsocial community)
  // for all options, look at https://github.com/pkcprotocol/pkc-js?tab=readme-ov-file#communityeditcommunityeditoptions
  "boardSettings": {
    // Feature flags that control how users interact with the board
    "features": {
      // Disable upvoting (imageboard-style: posts have no score)
      "noUpvotes": true,
      // Disable downvoting
      "noDownvotes": true,
      // New threads must include a link (URL)
      "requirePostLink": true,
      // Any new threads with link it has to be an image or media link
      "requirePostLinkIsMedia": true,

      // Replies don't need to include a link
      "requireReplyLink": false,

      // If replies include link it has to be of image or media
      "requireReplyLinkIsMedia": true,

      // Extra media files on a post or reply, published as comment.gallery (pkc-js 0.0.132
      // or newer). The count is on top of "link": with requirePostLinkIsMedia the first file
      // goes in "link" and the gallery holds the rest, so 3 allows 4 files per post. 0 means
      // a post or reply may carry a "link" but no gallery, like 4chan's one file per post.
      // Only nodes running the new pkc-js enforce these; older nodes store the fields without
      // checking galleries. 5chan does not render or publish galleries yet, so raising them
      // only affects other clients until it does.
      "maxPostGalleryItems": 0,
      "maxReplyGalleryItems": 0,

      // Authors get new address per thread (post), but inside the same thread they retain the same identity
      "pseudonymityMode": "per-post",

      // Uncomment for a board without an archive, like 4chan /b/ or /trash/. Threads that
      // fall past the last page are purged right away instead of archived, threads at the
      // bump limit are locked instead of archived, and 5chan hides the board's archive.
      // "noArchive": true,
    },
    "settings": {
      // Fetch metadata for link-hosted media so clients know image/video dimensions
      // before rendering. Bitsocial publications contain links rather than uploaded
      // media files, so without this metadata clients must use generic wrappers that
      // can cause poor sizing and layout shifts. The node fetches these links directly
      // unless fetchThumbnailUrlsProxyUrl is also configured.
      "fetchThumbnailUrls": true,

      // Challenge rules that control anti-spam and captcha behavior.
      // Each entry defines a challenge with a "name", "description", and "exclude" rules.
      // Challenges are evaluated in order; the first match is presented to the user.
      // "exclude" rules define who is exempted (e.g., moderators, trusted users).
      // Mod bypass uses "roles", which needs pkc-js >= 0.0.101 on the node; those
      // nodes reject the older "role" field. Older nodes ignore "roles", so their
      // moderators get these challenges like everyone else.

      "challenges": [
        {
          // Brute-force gate.
          // Authors who fail captcha 5+ times per hour get hard-rejected.
          // The hard reject itself increments the failure counter, creating
          // a progressive cooldown that keeps them locked out.
          "name": "fail",
          "description": "Blocks authors with excessive failed captcha attempts.",
          "options": {
            "error": "Too many failed attempts. Try again later.",
          },
          "exclude": [
            // Mod bypass.
            { "roles": ["moderator", "admin", "owner"] },

            // Anyone under 5 failed attempts per hour is excluded (allowed through).
            // Once failures hit 5/hr, this exclude stops matching and the fail
            // challenge applies, hard-rejecting the author.
            { "rateLimit": 5, "rateLimitChallengeSuccess": false },
          ],
        },
        {
          // CommentEdit policy gate.
          // Reject non-mod comment edits.
          "name": "fail",
          "description": "Disables CommentEdit publications on this board.",
          "options": {
            "error": "Comment edits are disabled on this board.",
          },
          "exclude": [
            // Mod bypass.
            { "roles": ["moderator", "admin", "owner"] },

            // Exclude all non-commentEdit publication types.
            // publicationType matching is OR, so this challenge applies only to commentEdit.
            {
              "publicationType": {
                "post": true,
                "reply": true,
                "vote": true,
                "commentModeration": true,
                "communityEdit": true,
              },
            },
          ],
        },

        // Optional wordfilter. This stays commented out so upgrading the board
        // manager never changes a board's published text policy automatically.
        // Before enabling it, install the challenge in bitsocial-cli:
        //   bitsocial challenge install @bitsocial/wordfilter-challenge@0.3.0
        // Also make sure every intended publishing client supports the
        // wordfilter/v1 contract; older clients will be rejected rather than
        // publishing an unfiltered word.
        // {
        //   "name": "@bitsocial/wordfilter-challenge",
        //   "description": "Replaces configured words before publications are signed.",
        //   "options": {
        //     // Both values are JSON strings because challenge options are strings.
        //     // Matching is literal and case-insensitive; regex, spaced spellings,
        //     // and Unicode lookalikes are intentionally not matched.
        //     // These are 4chan's classic filters (soy -> onions, tbh -> desu,
        //     // smh -> baka), so posters recognise the replacements on sight.
        //     "wordfilter/v1/rules": "[{\"src\":\"soy\",\"dst\":\"onions\"},{\"src\":\"tbh\",\"dst\":\"desu\"},{\"src\":\"smh\",\"dst\":\"baka\"}]",
        //     // Paths are prefixed with the publication type (wordfilter-challenge
        //     // 0.3.0 contract): post/reply content and titles, plus edited content.
        //     "wordfilter/v1/fieldNames": "[\"comment.content\",\"comment.title\",\"commentEdit.content\"]",
        //     "error": "This board replaces certain words. Please retry after refreshing the board.",
        //   },
        //   // Clients need both contract options to apply the same transformation.
        //   "publicOptions": [
        //     "wordfilter/v1/rules",
        //     "wordfilter/v1/fieldNames",
        //     "error",
        //   ],
        // },

        // The two entries below use Bitsocial's spam-blocker challenge, which is
        // strictly optional — it relies on a hosted service (Cloudflare Turnstile
        // challenges plus IP-reputation scoring via https://spamblocker.bitsocial.net).
        // If the board owner does not want to depend on that external service, both
        // entries can be removed; the "fail" entries above still provide brute-force
        // and commentEdit protection. Before applying this preset, install the
        // challenge in bitsocial-cli:
        //   bitsocial challenge install @bitsocial/spam-blocker-challenge
        {
          // Post spam-blocker gate.
          // Untrusted users or trusted users exceeding rate limit get risk-scored;
          // borderline scores present a Cloudflare challenge and go to pending approval.
          "name": "@bitsocial/spam-blocker-challenge",
          "description": "Post spam-blocker for untrusted or rate-exceeded users.",
          "pendingApproval": true,
          "exclude": [
            // Only for posts.
            { "publicationType": { "reply": true } },

            // Mod bypass (no rate limit).
            { "roles": ["moderator", "admin", "owner"] },

            // Trusted bypass requires sustained activity + account age + under rate limit.
            // If rate limit is exceeded, trust bypass stops matching and the challenge kicks in.
            {
              "postCount": 10,
              "firstCommentTimestamp": 604800,
              "rateLimit": 3,
              "rateLimitChallengeSuccess": true,
            },
            {
              "replyCount": 20,
              "firstCommentTimestamp": 604800,
              "rateLimit": 3,
              "rateLimitChallengeSuccess": true,
            },
          ],
        },
        {
          // Reply spam-blocker gate.
          // Untrusted users or trusted users exceeding rate limit get risk-scored;
          // borderline scores present a Cloudflare challenge and go to pending approval.
          "name": "@bitsocial/spam-blocker-challenge",
          "description": "Reply spam-blocker for untrusted or rate-exceeded users.",
          "pendingApproval": true,
          "exclude": [
            // Only for replies.
            { "publicationType": { "post": true } },

            // Mod bypass (no rate limit).
            { "roles": ["moderator", "admin", "owner"] },

            // Trusted bypass requires activity + account age + under rate limit.
            // Higher rate limit than posts since replies are lower-impact, but
            // reply flooding via sybil accounts is still a practical spam vector.
            {
              "postCount": 10,
              "firstCommentTimestamp": 604800,
              "rateLimit": 6,
              "rateLimitChallengeSuccess": true,
            },
            {
              "replyCount": 20,
              "firstCommentTimestamp": 604800,
              "rateLimit": 6,
              "rateLimitChallengeSuccess": true,
            },
          ],
        },
      ],

      // Page sorts the board publishes. Replaces pkc-js's nine default post sorts and five
      // reply sorts with what 5chan reads, which saves publish time and IPFS bytes.
      // Any change to "pages" regenerates every CommentUpdate once, on the next pass.
      // Before applying this preset, install the sort in bitsocial-cli (>= 0.19.107):
      //   bitsocial page-sort install @pkcprotocol/active-page-sort@0.0.7
      // Without it, `5chan board add --apply-defaults` is rejected by the RPC server
      // (ERR_RPC_CLIENT_PAGE_SORT_NAME_NOT_AVAILABLE_ON_SERVER); remove the posts entry
      // or use --skip-apply-defaults instead.
      "pages": {
        "posts": [
          {
            // Bump order where a reply whose content has a line equal to "sage" does not
            // bump its thread. Publishes under the "active" key 5chan reads (board, catalog,
            // archive; the catalog's other orders are re-sorted client-side).
            "name": "@pkcprotocol/active-page-sort",
            "options": {
              "noBumpKeywords": "sage",
              // Overwritten with the board's own boardManagerSettings.bumpLimit when the
              // preset is applied and whenever the board manager starts.
              "bumpLimit": "300",
            },
            "preloaded": true,
          },
          // 5chan v0.10.0 and older (desktop/Android builds not yet updated) fetch the
          // "new" sort for the catalog's "creation date" option. To keep that option
          // working for them, add: { "name": "new" }
        ],
        "replies": [
          // Thread view: oldest first, embedded in the record.
          { "name": "old", "preloaded": true },
          // Board-view reply preview: newest first, fetched on demand. 5chan requests the
          // "old"/"new" keys and flattens them client-side, so these are not oldFlat/newFlat.
          { "name": "new" },
        ],
      },
    },
  },
}
